<configuration>
  <input>
    <net-file value="yuelai.net.xml"/>
    <route-files value="yuelai.rou.xml,yuelai_taxis.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1200"/>
  </time>
  <processing>
    <device.taxi.dispatch-algorithm value="traci"/>
  </processing>
  <report>
    <ignore-route-errors value="true"/>
  </report>
</configuration>
