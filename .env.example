# Project environment variables — committed template.
# Copy to `.env` and edit for your machine. `.env` is gitignored.

# --- SUMO ---
# Root of the SUMO install (must contain tools/, bin/, data/).
# Default macOS Homebrew (DLR cask) path shown below.
SUMO_HOME=/Library/Frameworks/EclipseSUMO.framework/Versions/Current/EclipseSUMO/share/sumo

# --- Reproducibility ---
# Default seed for any script that doesn't override it on the CLI.
SEED=42

# --- Compute ---
# "cpu", "cuda", "mps", or "auto" (resolved at runtime).
DEVICE=auto

# --- Experiment tracking (optional) ---
# Set WANDB_MODE=disabled to skip wandb entirely.
# WANDB_API_KEY=
# WANDB_PROJECT=gat-mappo-fleet
# WANDB_MODE=disabled

# --- X11 display (macOS only, for sumo-gui) ---
# Required because the DLR SUMO build uses FOX/X11. After installing XQuartz
# and logging out/in, macOS usually sets this automatically. ":0" is the local
# XQuartz server.
DISPLAY=:0
